{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build assessment",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/VeriparkRagAssessment.csproj",
        "--configuration",
        "Debug",
        "-p:GenerateFullPaths=true"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
